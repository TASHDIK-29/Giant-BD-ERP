model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  name     String

  phone     String?
  gender    Gender?
  avatar    String?
  signature String?

  roleId Int

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  status Status @default(ACTIVE)

  refreshTokens RefreshToken[]
  loginOtps     LoginOtp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([status])
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  status      Status  @default(ACTIVE)

  users       User[]
  permissions RolePermission[]

  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PermissionGroup {
  id Int @id @default(autoincrement())

  name String
  key  String @unique

  description String?

  permissions Permission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id Int @id @default(autoincrement())

  name   String @unique
  action String

  permissionGroupId Int
  permissionGroup   PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([permissionGroupId, action])
  @@index([permissionGroupId])
}

model RolePermission {
  roleId       Int
  permissionId Int

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id Int @id @default(autoincrement())

  tokenHash String
  expiresAt DateTime

  revokedAt DateTime?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model LoginOtp {
  id Int @id @default(autoincrement())

  otpHash   String
  expiresAt DateTime

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id Int @id @default(autoincrement())

  name        String
  slug        String  @unique
  description String?

  parentId Int?

  parent Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)

  children Category[] @relation("CategoryHierarchy")

  mediaId Int?

  status    Status @default(ACTIVE)
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  masterProductsAsCategory MasterProduct[] @relation("MasterProductCategory")

  masterProductsAsSubCategory MasterProduct[] @relation("MasterProductSubCategory")

  @@index([parentId])
  @@index([status])
  @@index([sortOrder])
}

model Material {
  id Int @id @default(autoincrement())

  name        String  @unique
  description String?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  masterProducts MasterProduct[]
}

model Color {
  id Int @id @default(autoincrement())

  name        String  @unique
  description String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  productVariants ProductVariant[]
}

model MasterProduct {
  id Int @id @default(autoincrement())

  name String

  sku String @unique

  categoryId Int

  category Category @relation("MasterProductCategory", fields: [categoryId], references: [id], onDelete: Restrict)

  subCategoryId Int?

  subCategory Category? @relation("MasterProductSubCategory", fields: [subCategoryId], references: [id], onDelete: Restrict)

  materialId Int

  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  status Status @default(ACTIVE)

  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([materialId])
}

model ProductVariant {
  id Int @id @default(autoincrement())

  masterProductId Int

  masterProduct MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Restrict)

  colorId Int

  color Color @relation(fields: [colorId], references: [id], onDelete: Restrict)

  gender Gender

  size String

  sku String @unique

  modelNumber String?

  uom Uom

  productsPerPacket Int

  packagingType PackagingType

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([masterProductId, colorId, gender, size])
  @@index([masterProductId])
  @@index([colorId])
}

model Warehouse {
  id          Int     @id @default(autoincrement())
  name        String
  code        String  @unique
  description String?
  status      Status  @default(ACTIVE)

  zones Zone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Zone {
  id          Int     @id @default(autoincrement())
  name        String
  code        String
  description String?
  status      Status  @default(ACTIVE)

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  subZones SubZone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

model SubZone {
  id          Int     @id @default(autoincrement())
  name        String
  code        String
  description String?
  status      Status  @default(ACTIVE)

  zoneId Int
  zone   Zone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  racks Rack[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([zoneId, code])
  @@index([zoneId])
}

model Rack {
  id          Int     @id @default(autoincrement())
  name        String
  code        String
  description String?
  status      Status  @default(ACTIVE)

  subZoneId Int
  subZone   SubZone @relation(fields: [subZoneId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subZoneId, code])
  @@index([subZoneId])
}

model Buyer {
  id Int @id @default(autoincrement())

  name   String
  type   BuyerType
  status Status    @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, type])
  @@index([type])
  @@index([status])
}

enum BuyerType {
  LOCAL
  INTERNATIONAL
}

enum Gender {
  MALE
  FEMALE
}

enum Status {
  ACTIVE
  INACTIVE
}

enum Uom {
  PCS
  PAIR
  LEFT
  RIGHT
  KG
  GRAM
  LITER
  ML
  BOX
  PACK
  SET
}

enum PackagingType {
  BOX
  CARTON
  PACKET
  POLYBAG
  BUNDLE
}
