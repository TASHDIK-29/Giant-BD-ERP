// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  name     String

  phone     String?
  gender    Gender?
  avatar    String?
  signature String?

  roleId Int

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  status Status @default(ACTIVE)

  refreshTokens RefreshToken[]
  loginOtps     LoginOtp[]

  stockInsCreated StockIn[] @relation("StockInCreatedBy")

  stockOutsCreated StockOut[] @relation("StockOutCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([status])
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  status      Status  @default(ACTIVE)

  users       User[]
  permissions RolePermission[]

  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PermissionGroup {
  id Int @id @default(autoincrement())

  name String
  key  String @unique

  description String?

  permissions Permission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id Int @id @default(autoincrement())

  name   String @unique
  action String

  permissionGroupId Int
  permissionGroup   PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([permissionGroupId, action])
  @@index([permissionGroupId])
}

model RolePermission {
  roleId       Int
  permissionId Int

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id Int @id @default(autoincrement())

  tokenHash String
  expiresAt DateTime

  revokedAt DateTime?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model LoginOtp {
  id Int @id @default(autoincrement())

  otpHash   String
  expiresAt DateTime

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id Int @id @default(autoincrement())

  name        String
  slug        String  @unique
  description String?

  parentId Int?

  parent Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)

  children Category[] @relation("CategoryHierarchy")

  mediaId Int?

  status    Status @default(ACTIVE)
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  masterProductsAsCategory MasterProduct[] @relation("MasterProductCategory")

  masterProductsAsSubCategory MasterProduct[] @relation("MasterProductSubCategory")

  @@index([parentId])
  @@index([status])
  @@index([sortOrder])
}

model Material {
  id Int @id @default(autoincrement())

  name        String  @unique
  description String?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  masterProducts MasterProduct[]
}

model Color {
  id Int @id @default(autoincrement())

  name        String  @unique
  description String?

  productVariants ProductVariant[]
  stockIns        StockIn[]

  stockOuts StockOut[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MasterProduct {
  id Int @id @default(autoincrement())

  name String

  sku String @unique

  categoryId Int

  category Category @relation("MasterProductCategory", fields: [categoryId], references: [id], onDelete: Restrict)

  subCategoryId Int?

  subCategory Category? @relation("MasterProductSubCategory", fields: [subCategoryId], references: [id], onDelete: Restrict)

  materialId Int

  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  status Status @default(ACTIVE)

  variants ProductVariant[]

  stockIns StockIn[]

  stockOuts StockOut[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([materialId])
}

model ProductVariant {
  id Int @id @default(autoincrement())

  masterProductId Int

  masterProduct MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Restrict)

  colorId Int

  color Color @relation(fields: [colorId], references: [id], onDelete: Restrict)

  gender Gender

  size String

  sku String @unique

  modelNumber String?

  uom Uom

  productsPerPacket Int

  packagingType PackagingType

  status Status @default(ACTIVE)

  stockInItems StockInItem[]
  inventories  Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([masterProductId, colorId, gender, size])
  @@index([masterProductId])
  @@index([colorId])
}

model Warehouse {
  id          Int     @id @default(autoincrement())
  name        String
  code        String  @unique
  description String?
  status      Status  @default(ACTIVE)

  zones Zone[]

  stockInItems StockInItem[]
  inventories  Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Zone {
  id          Int     @id @default(autoincrement())
  name        String
  code        String
  description String?
  status      Status  @default(ACTIVE)

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  subZones SubZone[]

  stockInItems StockInItem[]
  inventories  Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

model SubZone {
  id          Int     @id @default(autoincrement())
  name        String
  code        String
  description String?
  status      Status  @default(ACTIVE)

  zoneId Int
  zone   Zone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  racks Rack[]

  stockInItems StockInItem[]
  inventories  Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([zoneId, code])
  @@index([zoneId])
}

model Rack {
  id          Int     @id @default(autoincrement())
  name        String
  code        String
  description String?
  status      Status  @default(ACTIVE)

  subZoneId Int
  subZone   SubZone @relation(fields: [subZoneId], references: [id], onDelete: Restrict)

  stockInItems StockInItem[]
  inventories  Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subZoneId, code])
  @@index([subZoneId])
}

model Buyer {
  id Int @id @default(autoincrement())

  name   String
  type   BuyerType
  status Status    @default(ACTIVE)

  lettersOfCredit LetterOfCredit[]

  stockOuts StockOut[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, type])
  @@index([type])
  @@index([status])
}

model LetterOfCredit {
  id Int @id @default(autoincrement())

  lcNumber String @unique

  buyerId Int
  buyer   Buyer @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  purchaseOrders PurchaseOrder[]

  stockOuts StockOut[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent the same LC number
  // from being created twice for one buyer
  @@unique([buyerId, lcNumber])
  @@index([buyerId])
}

model PurchaseOrder {
  id Int @id @default(autoincrement())

  poNumber String @unique

  letterOfCreditId Int

  letterOfCredit LetterOfCredit @relation(fields: [letterOfCreditId], references: [id], onDelete: Restrict)

  stockOuts StockOut[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent duplicate PO numbers under the same LC
  @@unique([letterOfCreditId, poNumber])
  @@index([letterOfCreditId])
}

model StockIn {
  id Int @id @default(autoincrement())

  batchId String @unique

  masterProductId Int

  masterProduct MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Restrict)

  colorId Int

  color Color @relation(fields: [colorId], references: [id], onDelete: Restrict)

  gender Gender

  stockInDate DateTime

  productionDate DateTime

  expiryDate DateTime?

  totalQuantity Int

  totalPackages Int

  createdById Int

  createdBy User @relation("StockInCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items StockInItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([masterProductId])
  @@index([colorId])
  @@index([createdById])
  @@index([stockInDate])
}

model StockInItem {
  id Int @id @default(autoincrement())

  stockInId Int

  stockIn StockIn @relation(fields: [stockInId], references: [id], onDelete: Cascade)

  productVariantId Int

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  quantity Int

  warehouseId Int

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  zoneId Int

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  subZoneId Int

  subZone SubZone @relation(fields: [subZoneId], references: [id], onDelete: Restrict)

  rackId Int

  rack Rack @relation(fields: [rackId], references: [id], onDelete: Restrict)

  inventoryBatches InventoryBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stockInId, productVariantId, warehouseId, zoneId, subZoneId, rackId])
  @@index([stockInId])
  @@index([productVariantId])
  @@index([warehouseId])
  @@index([zoneId])
  @@index([subZoneId])
  @@index([rackId])
}

model Inventory {
  id Int @id @default(autoincrement())

  productVariantId Int

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  warehouseId Int

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  zoneId Int

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  subZoneId Int

  subZone SubZone @relation(fields: [subZoneId], references: [id], onDelete: Restrict)

  rackId Int

  rack Rack @relation(fields: [rackId], references: [id], onDelete: Restrict)

  quantity Int @default(0)

  inventoryBatches InventoryBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productVariantId, warehouseId, zoneId, subZoneId, rackId])
  @@index([productVariantId])
  @@index([warehouseId])
  @@index([zoneId])
  @@index([subZoneId])
  @@index([rackId])
}

model InventoryBatch {
  id Int @id @default(autoincrement())

  /**
   * Physical inventory location.
   */
  inventoryId Int

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  /**
   * Original Stock In source.
   */
  stockInItemId Int

  stockInItem StockInItem @relation(fields: [stockInItemId], references: [id], onDelete: Restrict)

  /**
   * Remaining quantity from this particular
   * Stock In item at this location.
   */
  quantity Int @default(0)

  stockOutItems StockOutItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * One StockInItem should create one batch record
   * for one Inventory location.
   */
  @@unique([inventoryId, stockInItemId])
  @@index([inventoryId])
  @@index([stockInItemId])
}

model StockOut {
  id Int @id @default(autoincrement())

  /**
   * Auto-generated transaction number.
   */
  stockOutNumber String @unique

  /**
   * Buyer → LC → PO
   */
  buyerId Int

  buyer Buyer @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  letterOfCreditId Int

  letterOfCredit LetterOfCredit @relation(fields: [letterOfCreditId], references: [id], onDelete: Restrict)

  purchaseOrderId Int

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  /**
   * Product selection.
   */
  masterProductId Int

  masterProduct MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Restrict)

  colorId Int

  color Color @relation(fields: [colorId], references: [id], onDelete: Restrict)

  gender Gender

  /**
   * Transaction information.
   */
  requestDate DateTime

  stockOutDate DateTime?

  status StockOutStatus @default(ISSUED)

  /**
   * Audit information.
   */
  createdById Int

  createdBy User @relation("StockOutCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items StockOutItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@index([letterOfCreditId])
  @@index([purchaseOrderId])
  @@index([masterProductId])
  @@index([colorId])
  @@index([status])
  @@index([createdById])
  @@index([requestDate])
}

model StockOutItem {
  id Int @id @default(autoincrement())

  stockOutId Int

  stockOut StockOut @relation(fields: [stockOutId], references: [id], onDelete: Cascade)

  /**
   * Exact batch and location from which
   * the inventory is being issued.
   */
  inventoryBatchId Int

  inventoryBatch InventoryBatch @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * Prevent duplicate allocations from the same
   * InventoryBatch within one Stock Out transaction.
   */
  @@unique([stockOutId, inventoryBatchId])
  @@index([stockOutId])
  @@index([inventoryBatchId])
}

enum BuyerType {
  LOCAL
  INTERNATIONAL
}

enum Gender {
  MALE
  FEMALE
}

enum Status {
  ACTIVE
  INACTIVE
}

enum Uom {
  PCS
  PAIR
  LEFT
  RIGHT
  KG
  GRAM
  LITER
  ML
  BOX
  PACK
  SET
}

enum PackagingType {
  BOX
  CARTON
  PACKET
  POLYBAG
  BUNDLE
}

enum StockOutStatus {
  ISSUED
  DELIVERED
  RECEIVED
}
